# Store Preview — config. Copy to .env (gitignored).
# The template ships with BUNDLED DUMMY DATA (listing.json + listing-current.json),
# so the static preview, New/Current toggle, Review Diff and lightbox work as-is.
# You only need the APP_DIST + store-credential block (bottom) if you wire up
# real store data via gen-listing.py (regenerate listing.json) or the Sync button.

# --- Server ---
PORT=8092
OPEN_BROWSER=true

# --- App identity (only used when regenerating listing.json via gen-listing.py) ---
APP_NAME="Your App Name"
DEVELOPER="Your Company"
IOS_BUNDLE_ID="com.example.app"
ANDROID_PACKAGE="com.example.app"
VERSION_NAME="1.0.0"
VERSION_CODE="1"
DEFAULT_LOCALE="en-US"
LOCALES="en-US,vi"
PLAY_CATEGORY="Puzzle"
APPSTORE_CATEGORY="Games"
APPSTORE_SECONDARY_CATEGORY="Entertainment"
AGE="4+"
CONTENT_RATING="Everyone / 4+"
CONTENT_ADVISORY="No ads"
MARKETING_URL="https://example.com/"
SUPPORT_URL="https://example.com/support/"

# --- Real store data (OPTIONAL — for gen-listing.py + Sync; leave unset to use bundled dummy) ---
# APP_DIST=".app_dist"                       # repo with fastlane metadata + creds
# ASC_KEY_ID=""
# ASC_ISSUER_ID=""
# BUNDLE_ID="com.example.app"
# PLAYSTORE_PACKAGE_NAME="com.example.app"
# Credential files can be given as a path OR embedded base64 single-line (preferred — self-contained).
# The Export ▸ Env tab emits the *_B64 form; Import decodes it back automatically.
# ASC_KEY_P8="./AuthKey_XXXXXXXXXX.p8"        # path …
# ASC_KEY_P8_B64=""                          # …or base64 of the .p8 (single line)
# PLAYSTORE_SERVICE_ACCOUNT_JSON="./sa.json" # path …
# PLAYSTORE_SERVICE_ACCOUNT_JSON_B64=""      # …or base64 of the JSON (single line)
