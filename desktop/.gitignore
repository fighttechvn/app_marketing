node_modules/
# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/
# generated sidecar binary (built by scripts/build-sidecar.sh)
src-tauri/binaries/
# bundled UxPlay + GStreamer (populated by scripts/build-uxplay-gstreamer.sh) —
# keep only the README that documents the layout
src-tauri/tools/*
!src-tauri/tools/README.md
# UxPlay source clone (build_windows/build_macos clone + build it here)
.uxplay-src/
# PyInstaller + staging
.sidecar-build/
.pyi-dist/
.pyi-work/
.pyi-spec/
.icon-1024.png
# local sidecar build venv (created to work around PEP 668)
.venv-build/
# signing secrets — never commit the cert / notary key / filled env
.signing/*
!.signing/signing.env.example
# generated icons (run scripts/build.sh / `tauri icon`)
src-tauri/icons/
.DS_Store
